{
  "name": "BoxFlow ToF Mock — perfil VL53L5CX 8x8",
  "author": "BoxFlow",
  "pins": [
    "VCC",
    "GND",
    "SCL",
    "SDA"
  ],
  "display": {
    "width": 256,
    "height": 218
  },
  "controls": [
    {
      "id": "fill",
      "label": "Altura da pilha: 0 a 100% de 0,10 m",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "id": "shape",
      "label": "Forma: 0 pirâmide, 1 duas, 2 prisma, 3 rampa, 4 camada",
      "type": "range",
      "min": 0,
      "max": 4,
      "step": 1
    },
    {
      "id": "centerX",
      "label": "Centro da pilha X (m)",
      "type": "range",
      "min": 0.1,
      "max": 0.2,
      "step": 0.01
    },
    {
      "id": "obstacle",
      "label": "Viga de oclusão (0/1)",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "id": "dropout",
      "label": "Sem retorno (%)",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 10
    },
    {
      "id": "rangeM",
      "label": "Limite induzido de alcance (m; não modela iluminação)",
      "type": "range",
      "min": 0.2,
      "max": 4,
      "step": 0.1
    },
    {
      "id": "yaw",
      "label": "Orientação yaw (graus)",
      "type": "range",
      "min": -20,
      "max": 20,
      "step": 5
    },
    {
      "id": "tilt",
      "label": "Inclinação (graus)",
      "type": "range",
      "min": -15,
      "max": 15,
      "step": 1
    },
    {
      "id": "sensorX",
      "label": "Sensor X (m)",
      "type": "range",
      "min": 0.05,
      "max": 0.25,
      "step": 0.01
    },
    {
      "id": "sensorY",
      "label": "Sensor Y (m)",
      "type": "range",
      "min": 0.05,
      "max": 0.25,
      "step": 0.01
    },
    {
      "id": "sensorZ",
      "label": "Sensor Z (m)",
      "type": "range",
      "min": 0.2,
      "max": 0.6,
      "step": 0.005
    },
    {
      "id": "freeze",
      "label": "Congelar varredura (0/1)",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "id": "i2cFault",
      "label": "Falha I2C NACK (0/1)",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 1
    }
  ]
}
